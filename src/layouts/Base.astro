---
import "../styles/global.css";
import Header from "../components/Header.astro";
import WorkOverlay from "../components/WorkOverlay.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  /** `dark` = the full-bleed hero, which also carries the corner links.
   *  `light` = an inner page. Both are white type on black now that the ground
   *  is black sitewide; the flag only decides the corner nav. */
  chrome?: "dark" | "light";
  /** Deep hue — surfaces (hover washes, the work panel). */
  accent?: string;
  /** Lifted hue — ink on the black ground (headings, rules, focus). */
  tint?: string;
  /** Gallery/about/contact pages get a bottom border under the fixed header. */
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  chrome = "light",
  accent = "#b83b6c",
  tint = "#ff4d9d",
  bodyClass = "",
} = Astro.props;

const fullTitle =
  title === site.wordmark ? `${site.wordmark} — ${site.role}` : `${title} | ${site.wordmark}`;
---

<!doctype html>
<html lang="en" data-chrome={chrome}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="preload"
      href="/fonts/Satoshi-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#000000" />
    <style define:vars={{ accent, tint }}>
      :root { --accent: var(--accent); --tint: var(--tint); }
    </style>
  </head>
  <body class={bodyClass} style={`--accent:${accent};--tint:${tint}`}>
    <!--
      THESIS: Five doors into one photographer's sport work. Refuses the single
      undifferentiated feed a portfolio template ships; the visitor came for one
      sport and gets it in one action.
      OWN-WORLD: Black ground everywhere, white type, grey seconds. Satoshi
      300-900, 14px for everything functional, weight carries hierarchy. One
      saturated accent per topic (cobalt, olive, brick, raspberry, ember) in two
      steps - deep for surfaces, lifted for ink on black - plus the pink that
      carries the wordmark and floods the work panel. No shadow, no gradient, no
      rounded corner, no card.
      STORY: Arrives from Instagram on a phone, meets one photograph at full
      bleed, opens WORK, picks a sport, judges twenty frames, emails.
      FIRST VIEWPORT: Full-bleed frame under a 40% black scrim; REYNA in Satoshi
      Black at --size-hero centred in pink; role beneath in 22px; WORK left and
      CONTACT right in a 60px transparent header; ABOUT and CONTACT under the
      name; chevron bottom.
      FORM: Inherited world, not a new one. DESIGN.md 2-10, measured from the
      user-pinned reference. Brief-pinned, so no concept roll and no seed key.
      SIGNATURE: the WORK overlay floods with the hovered topic's accent while
      its cover frame rises in the corner; the hero shrinks to the column width
      on scroll. Motion grammar: 0.25s and 0.4s ease-in-out, nothing else.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <Header chrome={chrome} />
    <WorkOverlay />
    <main id="main">
      <slot />
    </main>

    <script>
      // Overlay open/close. The panel is always in the DOM and translated
      // off-screen, so opening is one class toggle and one transition.
      const overlay = document.getElementById("work-overlay");
      const openers = document.querySelectorAll<HTMLElement>("[data-open-work]");
      const closers = document.querySelectorAll<HTMLElement>("[data-close-work]");
      let lastFocus: HTMLElement | null = null;

      const setOpen = (open: boolean) => {
        if (!overlay) return;
        overlay.classList.toggle("is-open", open);
        overlay.setAttribute("aria-hidden", String(!open));
        document.body.classList.toggle("is-locked", open);
        openers.forEach((b) => b.setAttribute("aria-expanded", String(open)));
        if (open) {
          lastFocus = document.activeElement as HTMLElement;
          overlay.querySelector<HTMLElement>("a,button")?.focus();
        } else {
          lastFocus?.focus();
        }
      };

      openers.forEach((b) => b.addEventListener("click", () => setOpen(true)));
      closers.forEach((b) => b.addEventListener("click", () => setOpen(false)));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay?.classList.contains("is-open")) setOpen(false);
        if (e.key !== "Tab" || !overlay?.classList.contains("is-open")) return;
        // Focus trap — the reference has none; this is an addition.
        const f = overlay.querySelectorAll<HTMLElement>(
          'a[href],button:not([disabled])',
        );
        if (!f.length) return;
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    </script>
  </body>
</html>
