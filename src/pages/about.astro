---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { imagesFor } from "../lib/images";
import { site } from "../data/site";
import { experience } from "../data/topics";

// Not a cover — the five covers are all on the home page, and reusing one here
// showed the same frame twice in a visit. dance-cheer-08 is the moonrise stunt.
const portrait = imagesFor("dance-cheer")[7]!;
---

<Base title="About" chrome="light" accent="#b83b6c" tint="#ff4d9d">
  <article class="page">
    <header class="head">
      <p class="crumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About</span></p>
      <h1>About</h1>
    </header>

    <div class="body">
      <div class="prose">
        <p class="big">
          Based in both Hawaii and California, Reyna expresses her admiration for
          sports through visual storytelling.
        </p>
        <p>
          Her photography goes beyond the surface, capturing the emotion,
          atmosphere and artistry of athletics. Her experience ranges in both
          outdoor and indoor sports, action, portraiture, and landscape imagery.
          She brings a distinct style to her work through unconventional angles,
          thoughtful photo editing, and by capturing the story beyond the
          scoreboard.
        </p>

        <h2>Experience</h2>
        <ul class="experience">
          {experience.map((item) => <li>{item}</li>)}
        </ul>

        <h2>Work with her</h2>
        <p>
          Seasons, single games, meets, senior nights, and team portraits.
          The fastest way to start is an email —
          <a class="ln" href={`mailto:${site.email}`}>{site.email}</a> — or{" "}
          <a class="ln" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>.
        </p>
      </div>

      <aside class="aside">
        <Image
          src={portrait.src}
          alt=""
          widths={[400, 800, 1200]}
          sizes="(max-width: 991px) 100vw, 40vw"
          loading="lazy"
          class="shot"
        />
      </aside>
    </div>
  </article>

  <Footer />
</Base>

<style>
  .head { max-width: var(--max-content); margin: 0 auto; padding: 100px 20px 10px; }
  .crumb {
    font-size: var(--size-smaller); text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-mute); display: flex; gap: 8px; margin-bottom: 20px;
  }
  .crumb a:hover { border-bottom: 1px solid currentColor; }
  h1 { font-size: var(--size-hero); font-weight: 900; color: var(--tint); }

  .body {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 24px 20px 60px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .prose { max-width: var(--max-prose); }
  .prose p { font-weight: 300; margin-bottom: 1.1em; }
  .big { font-size: var(--size-big); font-weight: 700 !important; line-height: var(--leading-base); }

  h2 {
    font-size: var(--size-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 2.4em 0 1em;
    padding-top: 14px;
    border-top: 2px solid var(--tint);
  }

  /* Ten lines, not five links — this is a credential list, so it reads as one
     column of plain text rather than a second navigation. */
  .experience { list-style: none; margin: 0 0 1em; padding: 0; }
  .experience li {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
    font-weight: 400;
  }

  .ln { border-bottom: 1px solid currentColor; }
  .ln:hover { color: var(--tint); }

  .aside .shot { width: 100%; height: auto; }

  @media (min-width: 992px) {
    .head { padding: 140px var(--gutter-lg) 10px; }
    .body {
      grid-template-columns: 3fr 2fr;
      gap: 60px;
      padding: 30px var(--gutter-lg) 80px;
      align-items: start;
    }
    .aside { position: sticky; top: 100px; }
    /* Ten short items waste a full-width column; two columns keep the list
       inside one screen next to the bio. */
    .experience { columns: 2; column-gap: 40px; }
    .experience li { break-inside: avoid; }
  }
</style>
