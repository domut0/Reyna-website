---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { imagesFor } from "../lib/images";

// Not a cover — those are all on the home page. flag-football-06 is the night
// run-out, the one frame that reads as an invitation rather than a contest.
const backdrop = imagesFor("flag-football")[5]!;
// Names only. Each of these carried an explanatory line under it, which is the
// kind of copy that reads as filler on a portfolio — the words explain nothing
// a coach booking a game does not already know.
const shoots = [
  "Seasons",
  "Single games and meets",
  "Senior nights",
  "Gameday graphics",
];
---

<Base title="Contact" chrome="light" accent="#b83b6c" tint="#ff4d9d">
  <article class="page">
    <header class="head">
      <p class="crumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span></p>
      <h1>Get in touch</h1>
      <p class="where">{site.region}</p>
    </header>

    <div class="body">
      <div class="main">
        <a class="primary" href={`mailto:${site.email}`}>
          <span class="label small">Email</span>
          <span class="addr">{site.email}</span>
        </a>

        <a
          class="primary"
          href={site.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="label small">Instagram</span>
          <span class="addr">@{site.instagram}</span>
        </a>

        <h2>What she shoots</h2>
        <ul class="shoots">
          {shoots.map((name) => <li>{name}</li>)}
        </ul>
      </div>

      <aside class="aside">
        <Image
          src={backdrop.src}
          alt=""
          widths={[400, 800, 1200]}
          sizes="(max-width: 991px) 100vw, 40vw"
          loading="lazy"
          class="shot"
        />
      </aside>
    </div>
  </article>

  <Footer />
</Base>

<style>
  .head { max-width: var(--max-content); margin: 0 auto; padding: 100px 20px 10px; }
  .crumb {
    font-size: var(--size-smaller); text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-mute); display: flex; gap: 8px; margin-bottom: 20px;
  }
  .crumb a:hover { border-bottom: 1px solid currentColor; }
  h1 { font-size: var(--size-hero); font-weight: 900; color: var(--tint); }
  .where {
    font-size: var(--size-smaller); text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-mute); margin-top: 18px;
  }

  .body {
    max-width: var(--max-content); margin: 0 auto;
    padding: 24px 20px 60px;
    display: grid; grid-template-columns: 1fr; gap: 40px;
  }
  .main { max-width: var(--max-prose); }

  /* The one place on the site where an action is bigger than the photography. */
  .primary {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px 0;
    border-top: 2px solid var(--tint);
    transition: transform var(--transition-base), color var(--transition-base);
  }
  .primary:last-of-type { border-bottom: 2px solid var(--tint); }
  .primary:hover, .primary:focus-visible { transform: translateX(10px); color: var(--tint); }
  .small {
    font-size: var(--size-smaller); text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-mute); font-weight: 700;
  }
  .addr {
    font-size: clamp(1.35rem, 4.4vw, var(--size-huge));
    font-weight: 900;
    line-height: var(--leading-tight);
    word-break: break-word;
  }

  h2 {
    font-size: var(--size-small); text-transform: uppercase; letter-spacing: 0.08em;
    margin: 2.6em 0 1em;
  }
  .shoots { list-style: none; margin: 0; padding: 0; }
  .shoots li {
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .aside .shot { width: 100%; height: auto; }

  @media (min-width: 992px) {
    .head { padding: 140px var(--gutter-lg) 10px; }
    .body {
      grid-template-columns: 3fr 2fr; gap: 60px;
      padding: 30px var(--gutter-lg) 80px; align-items: start;
    }
    .aside { position: sticky; top: 100px; }
  }
</style>
