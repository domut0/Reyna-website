---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { site, hasPlaceholders } from "../data/site";
import { coverFor } from "../lib/images";

const backdrop = coverFor("dance-cheer")!;
const shoots = [
  ["A season", "Recurring coverage across a full schedule."],
  ["A single game or meet", "One event, edited and delivered."],
  ["Senior night", "Portraits and the ceremony."],
  ["Team portraits", "Roster and individual frames."],
  ["Gameday graphics", "Social assets built from the shoot."],
];
---

<Base title="Contact" chrome="light" accent="#2f518b">
  <article class="page">
    <header class="head">
      <p class="crumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span></p>
      <h1>Get in touch</h1>
      <p class="note">
        Email is the fastest way. Tell her the sport, the date, and the venue.
      </p>
    </header>

    <div class="body">
      <div class="main">
        {
          hasPlaceholders && (
            <p class="draft-flag" role="note">
              <strong>Placeholder details.</strong> The address and handle below
              are not real. Replace them in <code>src/data/site.ts</code>.
            </p>
          )
        }

        <a class="primary" href={`mailto:${site.email}`}>
          <span class="label small">Email</span>
          <span class="addr">{site.email}</span>
        </a>

        <a
          class="primary"
          href={site.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="label small">Instagram</span>
          <span class="addr">@{site.instagram}</span>
        </a>

        <h2>What she shoots</h2>
        <ul class="shoots">
          {shoots.map(([name, detail]) => (
            <li>
              <strong>{name}</strong>
              <span>{detail}</span>
            </li>
          ))}
        </ul>

        <p class="fine">
          No booking form — email reaches her directly and gets a faster answer.
        </p>
      </div>

      <aside class="aside">
        <Image
          src={backdrop.src}
          alt=""
          widths={[400, 800, 1200]}
          sizes="(max-width: 991px) 100vw, 40vw"
          loading="lazy"
          class="shot"
        />
      </aside>
    </div>
  </article>

  <Footer />
</Base>

<style>
  .head { max-width: var(--max-content); margin: 0 auto; padding: 100px 20px 10px; }
  .crumb {
    font-size: var(--size-smaller); text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-mute); display: flex; gap: 8px; margin-bottom: 20px;
  }
  .crumb a:hover { border-bottom: 1px solid currentColor; }
  h1 { font-size: var(--size-hero); font-weight: 900; color: var(--accent); }
  .note {
    font-size: var(--size-big); font-weight: 300; margin-top: 0.4em; max-width: 34ch;
  }

  .body {
    max-width: var(--max-content); margin: 0 auto;
    padding: 24px 20px 60px;
    display: grid; grid-template-columns: 1fr; gap: 40px;
  }
  .main { max-width: var(--max-prose); }

  .draft-flag {
    font-size: var(--size-smaller);
    background: #f2f2f2;
    padding: 14px 16px;
    box-shadow: inset 0 2px 0 0 var(--accent);
    margin-bottom: 2em;
  }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.95em; }

  /* The one place on the site where an action is bigger than the photography. */
  .primary {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px 0;
    border-top: 2px solid var(--accent);
    transition: transform var(--transition-base), color var(--transition-base);
  }
  .primary:last-of-type { border-bottom: 2px solid var(--accent); }
  .primary:hover, .primary:focus-visible { transform: translateX(10px); color: var(--accent); }
  .small {
    font-size: var(--size-smaller); text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-mute); font-weight: 700;
  }
  .addr {
    font-size: clamp(1.35rem, 4.4vw, var(--size-huge));
    font-weight: 900;
    line-height: var(--leading-tight);
    word-break: break-word;
  }

  h2 {
    font-size: var(--size-small); text-transform: uppercase; letter-spacing: 0.08em;
    margin: 2.6em 0 1em;
  }
  .shoots { list-style: none; margin: 0; padding: 0; }
  .shoots li {
    display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline;
    padding: 12px 0; border-bottom: 1px solid #e4e4e4;
  }
  .shoots strong { font-weight: 900; }
  .shoots span { color: var(--color-mute); font-weight: 300; }

  .fine {
    margin-top: 2em; font-size: var(--size-small); font-weight: 300;
    color: var(--color-mute);
  }

  .aside .shot { width: 100%; height: auto; }

  @media (min-width: 992px) {
    .head { padding: 140px var(--gutter-lg) 10px; }
    .body {
      grid-template-columns: 3fr 2fr; gap: 60px;
      padding: 30px var(--gutter-lg) 80px; align-items: start;
    }
    .aside { position: sticky; top: 100px; }
  }
</style>
